; ******************************************************************************
; main code section
;
; ******************************************************************************

    include init.m68k
    include demo.m68k


MAIN:

; --------------------------------------
; load data to memory
; --------------------------------------
    LOAD_Z80_MACRO
    DEMO_LOAD_SRC_MACRO ; load resources for demo
; --------------------------------------
; core demo
; --------------------------------------
    DEMO_CLR_MACRO ; fill screen with 0 tyle and set background color to 0
    DEMO_DRAW_LOGO_MACRO 0x0, 0x0               ; mega drive core
    DRAW_TEXT_MACRO UPTIME_STR, 0x11, 0x1B, 0x3 ; uptime


;   DEMO_DRAW_INFO_MACRO ; screen0 - m68k info
; --------------------------------------
; main loop
; --------------------------------------
MAIN_LOOP:
    DEMO_MAIN_LOOP_MACRO

    jmp MAIN_LOOP


; --------------------------------------
; horizontal retrace
; --------------------------------------
HINT:

    rte


; --------------------------------------
; vertical retrace
; --------------------------------------
VINT:
    UPDATE_TIME_MACRO

    rte


; --------------------------------------
; exception
; --------------------------------------
EXCEPTION:
    stop #$2700 ; halt cpu


    include data.m68k
    include font.m68k
    include memory.m68k


Z80_DATA:
    incbin ../../build/z80.bin


ROM_END:
